{
  "name": "@mrenwick13/vikunja-mcp-server",
  "version": "0.2.0",
  "description": "Model Context Protocol server for Vikunja task management with full coverage of tasks, projects, views, buckets, labels, filters, comments, assignees, relations, and subscriptions.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "vikunja-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "clean": "rm -rf dist",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "axios": "^1.7.9",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "license": "MIT",
  "author": "mrenwick13",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrenwick13/vikunja-mcp-server"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "vikunja",
    "task-management",
    "kanban"
  ]
}
